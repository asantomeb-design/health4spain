# =============================================
# HEALTH4SPAIN - Variables de Entorno
# =============================================
# Copia este archivo a .env.local y rellena los valores

# =============================================
# SUPABASE (Obligatorio)
# =============================================
# URL de tu proyecto Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anon (Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave service_role (Settings > API > service_role)
# ⚠️ SOLO SERVIDOR - NUNCA EXPONER EN FRONTEND
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================
# ADMINISTRACIÓN (Obligatorio)
# =============================================
# Emails de administradores autorizados (separados por coma)
# Solo estos emails pueden acceder a /administrator
NEXT_PUBLIC_ADMIN_EMAILS=admin@health4spain.com,tu-email@gmail.com

# =============================================
# TINYMCE (Obligatorio para blog)
# =============================================
# API Key de TinyMCE (obtener en https://www.tiny.cloud/)
# Registrarse gratis, crear "Tiny Account" y copiar API key
NEXT_PUBLIC_TINYMCE_API_KEY=tu-api-key-de-tinymce

# =============================================
# OPENAI (Opcional - para generar landings)
# =============================================
# API Key de OpenAI (https://platform.openai.com/api-keys)
# Solo necesaria para ejecutar: npm run generate-landings
OPENAI_API_KEY=sk-...

# =============================================
# GOHIGHLEVEL CRM (Opcional - para sincronizar leads)
# =============================================
# Token de integración privada (GHL > Settings > Private Integrations > New)
# Scopes necesarios: contacts.write, contacts.readonly
GHL_PRIVATE_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Location ID de tu sub-cuenta GHL (GHL > Settings > Business Profile > Location ID)
GHL_LOCATION_ID=abc123xyz456

# Opcional: mapa JSON { "clave_interna": "uuid_campo_en_ghl" } para rellenar custom fields en la API.
# Las claves permitidas: ciudad_interes, ciudad_origen, pais_origen, servicio_solicitado, presupuesto,
# urgencia, idioma_preferido, landing_page, utm_campaign, lead_score, mensaje, fecha_nacimiento
# UUIDs: GHL > Settings > Custom Fields (cada campo tiene ID en la URL o en la API).
# GHL_CUSTOM_FIELD_IDS={"ciudad_interes":"xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"}

# Webhook entrante (Workflows > Incoming Webhook) — POST JSON desde /api/leads para TODOS los servicios.
# El tipo de servicio va en el JSON como `servicio` (y `tipo_ruta`: salud | otros) para filtros/ramas en GHL.
GHL_INCOMING_WEBHOOK_SALUD=https://services.leadconnectorhq.com/hooks/...
#
# Mapeo sugerido en GHL (Crear contacto):
# - City (estándar)        → {{inboundWebhookRequest.ciudad_origen}}
# - ¿Dónde en España?      → {{inboundWebhookRequest.ciudad_servicio_espana_nombre}} (o slug: ciudad_servicio_espana)
# - Slug = ciudad_interes del formulario; mismo valor en: ciudad, ciudad_interes, ciudad_servicio_espana

# =============================================
# WHATSAPP (Opcional)
# =============================================
# Número de WhatsApp Business (sin + ni espacios)
NEXT_PUBLIC_WHATSAPP_NUMBER=34600000000

# =============================================
# ANALYTICS (Opcional)
# =============================================
# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# =============================================
# EMAIL (Opcional - para notificaciones)
# =============================================
# Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxx

# Email de destino para notificaciones de leads
NOTIFICATION_EMAIL=leads@health4spain.com

# =============================================
# SITE CONFIG
# =============================================
NEXT_PUBLIC_SITE_URL=https://www.health4spain.com
NEXT_PUBLIC_SITE_NAME=Health4Spain
