# =============================================
# HEALTH4SPAIN - Variables de Entorno
# =============================================
# Copia este archivo a .env.local y rellena los valores

# =============================================
# SUPABASE (Obligatorio)
# =============================================
# URL de tu proyecto Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anon (Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave service_role (Settings > API > service_role)
# ⚠️ SOLO SERVIDOR - NUNCA EXPONER EN FRONTEND
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================
# ADMINISTRACIÓN (Obligatorio)
# =============================================
# Emails de administradores autorizados (separados por coma)
# Solo estos emails pueden acceder a /administrator
NEXT_PUBLIC_ADMIN_EMAILS=admin@health4spain.com,tu-email@gmail.com

# =============================================
# TINYMCE (Obligatorio para blog)
# =============================================
# API Key de TinyMCE (obtener en https://www.tiny.cloud/)
# Registrarse gratis, crear "Tiny Account" y copiar API key
NEXT_PUBLIC_TINYMCE_API_KEY=tu-api-key-de-tinymce

# =============================================
# OPENAI (Chat Mar-IA + asistente blog + scripts de generación)
# =============================================
# API Key de OpenAI (https://platform.openai.com/api-keys)
# Usada por: widget Mar-IA, rutas /api/admin/blog/ai/* (propuestas, redacción, traducción, imagen),
# y scripts como npm run generate-landings cuando apliquen.
OPENAI_API_KEY=sk-...

# =============================================
# SERPAPI (Opcional — modo «Noticias» del asistente blog)
# =============================================
# https://serpapi.com — Google News para titulares en el wizard «Crear con IA»
SERPAPI_KEY=

# =============================================
# GOHIGHLEVEL CRM (Opcional - para sincronizar leads)
# =============================================
# Token de integración privada (GHL > Settings > Private Integrations > New)
# Scopes necesarios: contacts.write, contacts.readonly
GHL_PRIVATE_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Location ID de tu sub-cuenta GHL (GHL > Settings > Business Profile > Location ID)
GHL_LOCATION_ID=abc123xyz456

# Opcional: mapa JSON { "clave_interna": "uuid_campo_en_ghl" } para rellenar custom fields en la API.
# Las claves permitidas: ciudad_interes, ciudad_origen, pais_origen, servicio_solicitado,
# h4s_servicio, h4s_ciudad, h4s_pais_origen, h4s_plazo_necesidad, h4s_idioma, h4s_presupuesto,
# h4s_score, presupuesto, urgencia, idioma_preferido, landing_page, utm_campaign, lead_score,
# mensaje, fecha_nacimiento
# UUIDs: GHL > Settings > Custom Fields (cada campo tiene ID en la URL o en la API).
# GHL_CUSTOM_FIELD_IDS={"ciudad_interes":"xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"}

# Webhook entrante (Workflows > Incoming Webhook) — POST JSON desde /api/leads para TODOS los servicios.
# El tipo de servicio va en el JSON como `servicio` (y `tipo_ruta`: salud | otros) para filtros/ramas en GHL.
GHL_INCOMING_WEBHOOK_SALUD=https://services.leadconnectorhq.com/hooks/...
#
# Mapeo GHL (brief H4S_BR_1_v2) — mantener nombres del webhook, mapear en GHL:
# - servicio              → h4s_servicio (slug: seguros, abogados, gestorias, inmobiliarias)
# - ciudad                → h4s_ciudad (destino España, slug: murcia, lorca…)
# - ciudad_origen         → ciudad de procedencia del lead
# - servicio_es           → texto legible para emails ("Seguro de Salud")
# - ciudad_servicio_espana_nombre → nombre destino para emails ("Murcia")
# - origen                → etiqueta/campo = web
# - urgencia              → h4s_plazo_necesidad
# - idioma_preferido      → h4s_idioma
# Multiservicio: la web envía un POST del webhook por cada servicio.
# - Presupuesto            → {{inboundWebhookRequest.presupuesto_es}}
# - País (lista ya en ES)  → {{inboundWebhookRequest.pais_origen_es}}
# - Fecha nac. legible     → {{inboundWebhookRequest.fecha_nacimiento_legible_es}}
# Los custom fields rellenados por API usan las mismas etiquetas ES (servicio, urgencia, presupuesto, ciudad_interes).
# Los slugs técnicos siguen en: servicio, urgencia, presupuesto, ciudad_servicio_espana

# --- HUB COLABORADORES · GHL entrante (GHL → Hub) ---
# Secreto compartido del webhook entrante. La URL en GHL será:
#   https://TU_DOMINIO/api/hub/ghl/webhook?secret=<este_valor>
# (también admite el header x-webhook-secret). Sin este valor el endpoint queda cerrado.
GHL_WEBHOOK_SECRET=
# IDs de stage que definen el CVR (los confirma Claudia; se ven en /hub/integraciones).
# Cuando ambos estén puestos, el webhook empieza a clasificar eventos recibido/cerrado.
GHL_STAGE_RECIBIDO=
GHL_STAGE_CERRADO=
# Opcional: pipeline de seguros para acotar la búsqueda de oportunidades en el CVR.
GHL_PIPELINE_SEGUROS=

# =============================================
# WHATSAPP (Opcional)
# =============================================
# Número de WhatsApp Business (sin + ni espacios)
NEXT_PUBLIC_WHATSAPP_NUMBER=34614404562

# =============================================
# ANALYTICS (Opcional)
# =============================================
# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Meta (Facebook) Pixel — ID numérico del pixel en Meta Events Manager
NEXT_PUBLIC_META_PIXEL_ID=1885591562124890

# =============================================
# EMAIL (Opcional - para notificaciones)
# =============================================
# Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxx

# Email de destino para notificaciones de leads
NOTIFICATION_EMAIL=leads@health4spain.com

# =============================================
# SITE CONFIG
# =============================================
NEXT_PUBLIC_SITE_URL=https://www.health4spain.com
NEXT_PUBLIC_SITE_NAME=Health4Spain
